# Camillia-MT radio daemon for the CardputerZero LoRa cap. Installed by
# linux/install/install.sh, which fills in the user.
[Unit]
Description=Camillia-MT LoRa radio (CardputerZero)
Wants=czero-cap-power.service
After=czero-cap-power.service time-sync.target

[Service]
User=@USER@
ExecStart=/usr/local/bin/camillia-czero
# /run/camillia holds the socket the screen app connects to.
RuntimeDirectory=camillia
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
