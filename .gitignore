.pio
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch
.claude
builds
scripts/resume-claude.sh
dist/
logs/
# Device backups from backup.sh. Multi-megabyte flash images, and nvs.bin holds
# the node's private identity key — not something to push anywhere.
backups/

# OTA image signing private key — NEVER commit; back this up securely.
ota_signing_key.pem

# Generated from RELEASE_NOTES.md by tools/gen_release_notes.py as a pre: build
# step, so it is rewritten before every compile. Tracking it meant it went dirty
# after every release, and the committed copy was never the one that shipped.
src/release_notes.h

# Generated from lang/*.lang by tools/gen_lang_builtin.py on every build (#99).
src/i18n_builtin.h

# Generated from dict/en.txt by tools/gen_spell_dict.py on every build.
src/spell_dict_en.h

# Per-checkout PlatformIO core dirs and the file that selects them
# (scripts/lib/pio_core.sh). Gigabytes of toolchain and a machine-specific path.
.pio-core/
.pio-core-p4/
platformio_local.ini
